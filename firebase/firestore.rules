rules_version = '2';
// Правила безопасности Firestore для SDGoku.
// Вставьте в консоли Firebase: Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Прогресс игрока: читать и менять может только он сам.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Общий рейтинг: читать могут все, писать — только свою строку и только в допустимых пределах.
    match /leaderboards/{board}/scores/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'score', 'seconds', 'hints', 'mistakes', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.score is int && request.resource.data.score >= 20 && request.resource.data.score < 86400
        && request.resource.data.seconds is int && request.resource.data.seconds >= 20
        && request.resource.data.hints is int && request.resource.data.hints >= 0 && request.resource.data.hints <= 3
        && request.resource.data.mistakes is int && request.resource.data.mistakes >= 0 && request.resource.data.mistakes <= 2
        && request.resource.data.score == request.resource.data.seconds + request.resource.data.hints * 30;
    }
  }
}
